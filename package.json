{
  "name": "jatai-media-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm --prefix jatai_video run build:hub && npm --prefix jatai_lang/ide run build:hub",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "server:build": "g++ -std=c++20 -O2 -static server.cpp -o server.exe -lws2_32",
    "server": ".\\server.exe",
    "typecheck": "tsc --noEmit",
    "live": "vite build && concurrently -k -n build,server -c yellow,cyan \"vite build --watch\" \"npm:server\"",
    "video:install": "npm --prefix jatai_video install",
    "video:build": "npm --prefix jatai_video run build",
    "video:server:build": "npm --prefix jatai_video run server:build",
    "video:live": "npm --prefix jatai_video run live",
    "lang:install": "npm --prefix jatai_lang/ide install",
    "lang:build": "npm --prefix jatai_lang/ide run build",
    "lang:server:build": "npm --prefix jatai_lang/ide run server:build",
    "lang:live": "npm --prefix jatai_lang/ide run live"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
