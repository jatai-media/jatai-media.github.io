int soma(int a, int b)
    return a + b

#funcao com retorno de outros tipos

double media(double x, double y)
    return (x + y) / 2.0

string saudacao(string nome)
    return "ola, " + nome + "!"

bool par(int n)
    return n % 2 == 0

#funcao void: nao retorna valor

void linha(int tamanho)
    string barra = ""
    for i in range(tamanho)
        barra = barra + "-"
    println(barra)

#if/elif/else com return em todos os caminhos

string classificar(double nota)
    if nota >= 7.0
        return "aprovado"
    elif nota >= 5.0
        return "recuperacao"
    else
        return "reprovado"

#recursao

int fatorial(int n)
    if n <= 1
        return 1
    return n * fatorial(n - 1)

int fibonacci(int n)
    if n < 2
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

#usando as funcoes

int resultado = soma(2, 3)
println("soma(2, 3) = {resultado}")

double m = media(7.5, 9.0)
println("media: {m}")

println(saudacao("Ana"))

for n in range(1, 5)
    if par(n)
        println("{n} e par")
    else
        println("{n} e impar")

linha(20)

string situacao = classificar(6.0)
println("nota 6.0: {situacao}")

int f10 = fatorial(10)
println("10! = {f10}")

int fib = fibonacci(20)
println("fibonacci(20) = {fib}")

#chamadas aninhadas

int total = soma(soma(1, 2), soma(3, 4))
println("total: {total}")

#funcoes sem tipo: fn nome(parametros)
#o tipo de cada parametro vem do argumento da chamada, e o retorno vem do return

fn somar(a, b)
    return a + b

println("somar ints: {somar(2, 3)}")
println("somar doubles: {somar(1.5, 2.25)}")
println("somar strings: {somar("Ja", "tai")}")

#recursao: o caso base (primeiro return) define o tipo de retorno
fn potencia(base, expoente)
    if expoente == 0
        return 1
    return base * potencia(base, expoente - 1)
println("2^10 = {potencia(2, 10)}")

#fn sem return com valor nao devolve nada (como void)
fn moldura(texto)
    borda = ""
    for i in range(len(texto) + 4)
        borda = borda + "-"
    println(borda)
    println("| {texto} |")
    println(borda)
moldura("Jatai")

#da para misturar: tipo escrito em um parametro, sem tipo no outro
string repetir(string texto, vezes)
    r = ""
    for i in range(vezes)
        r = r + texto
    return r
println(repetir("ab", 3))
