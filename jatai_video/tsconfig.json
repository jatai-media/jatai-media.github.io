{
  // Projeto separado do hub: o editor de video tem o proprio tsconfig.
  //
  // A interface (src/ui) veio do jat.ai em C++, onde era JavaScript solto num
  // script so. Ela foi portada para modulos TypeScript, mas ainda sem tipos -
  // por isso o modo estrito fica desligado aqui, e nao no hub. O backend
  // (src/backend) e escrito ja tipado; apertar a interface arquivo por arquivo
  // e trabalho para depois.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
